# --- PostgreSQL ---
POSTGRES_USER=cnpj
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cnpj
POSTGRES_PORT=5432
# Tuning (~25% da RAM em shared_buffers, ~60% em effective_cache_size)
PG_SHARED_BUFFERS=4GB
PG_EFFECTIVE_CACHE_SIZE=10GB
PG_WORK_MEM=64MB
PG_MAINTENANCE_WORK_MEM=1GB

# --- ETL ---
# Fora do Docker, aponte para o banco local:
# DATABASE_URL=postgresql://cnpj:troque-esta-senha@localhost:5432/cnpj
RF_BASE_URL=https://arquivos.receitafederal.gov.br/dados/cnpj/dados_abertos_cnpj/
DOWNLOAD_CONCURRENCY=3
ETL_BATCH_MB=128
ETL_INDEX_WORKERS=2
ETL_MAINTENANCE_WORK_MEM=1GB
ETL_PARALLEL_WORKERS=2
ETL_MIN_ROW_RATIO=0.9
ETL_KEEP_ZIPS=1
ETL_CHECK_INTERVAL_HOURS=24

# Carga regional: só empresas ativas num raio de Jundiaí/SP (deixe vazio para o Brasil inteiro).
# 60 km cobre Campinas, Sorocaba e a Grande SP norte; o filtro de leads usa 30 km por padrão.
ETL_CENTRO=-23.1857,-46.8978
ETL_RAIO_KM=60
ETL_SOMENTE_ATIVAS=1
# Alternativas: ETL_UFS=SP  ou  ETL_MUNICIPIOS_IBGE=3525904,3523404 (códigos IBGE)
ETL_UFS=
ETL_MUNICIPIOS_IBGE=

# --- Geocodificação ---
# Instância própria (serviço nominatim): RPS e concorrência altos.
# Instância pública (https://nominatim.openstreetmap.org): RPS=1, CONCURRENCY=1,
# só para volumes pequenos — a política do OSM proíbe geocodificação em massa.
NOMINATIM_URL=http://nominatim:8080
NOMINATIM_RPS=50
NOMINATIM_CONCURRENCY=8
NOMINATIM_USER_AGENT=cnpj-intel-etl/0.1 (contato@suaempresa.com.br)
NOMINATIM_THREADS=4
MUNICIPIOS_URL=https://raw.githubusercontent.com/kelvins/municipios-brasileiros/main/csv/municipios.csv

# --- Redis (cache e rate limit da API) ---
REDIS_PORT=6379
REDIS_MAXMEMORY=1gb

# --- Publicação (Caddy) ---
# ":80" = HTTP local. Em produção, o domínio (DNS apontando para o servidor, portas 80/443 abertas):
# SITE_ADDRESS=cnpj.suaempresa.com.br   → HTTPS automático (Let's Encrypt)
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# Provedor de tiles do mapa (opcional). Os servidores públicos do OSM são para uso moderado.
# VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# TILE_HOSTS=https://*.tile.openstreetmap.org

# --- API ---
API_PORT=8000
# 1 quando o site estiver em HTTPS (cookie de sessão só trafega criptografado)
API_COOKIE_SECURE=0
API_SESSION_HOURS=12
API_LOGIN_MAX_TENTATIVAS=10
# Termos de uso próprios (Markdown; 1ª linha "versao: AAAA-MM-DD"). Vazio = texto padrão.
# Mudar a versão obriga todos os usuários a aceitar de novo.
API_TERMOS_ARQUIVO=
API_POOL_MIN=2
API_POOL_MAX=20
API_CACHE_TTL=86400
API_STATEMENT_TIMEOUT_MS=15000
# Origens liberadas para chamadas do navegador (separe por vírgula)
API_CORS_ORIGINS=*

# --- Leads (consórcio) ---
LEADS_CENTRO=-23.1857,-46.8978
LEADS_CENTRO_NOME=Jundiaí/SP
LEADS_RAIO_KM=30
# 1 se a API estiver atrás de um proxy reverso (usa X-Forwarded-For no log de acesso)
API_TRUST_PROXY=0
# 1 só em desenvolvimento: permite webhooks para localhost/rede interna
API_WEBHOOK_ALLOW_PRIVATE=0
API_GRAPH_MAX_NODES=300
# Retenção do log de acesso (Marco Civil: mínimo de 6 meses)
API_LOG_RETENCAO_DIAS=365

# --- Alertas operacionais (carga da Receita falhou/atrasada, webhooks falhando) ---
# URL de webhook do Slack, Discord, Teams (Power Automate) ou qualquer endpoint que aceite JSON
ALERTA_WEBHOOK_URL=
ALERTA_ETL_ATRASO_DIAS=40

# --- Backup diário (schemas app, geo, ops) ---
BACKUP_DIR=./backups
BACKUP_HORA=03
BACKUP_RETENCAO_DIAS=14
TZ=America/Sao_Paulo
